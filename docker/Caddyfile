# HTTPS in front of the app, for one reason: the browser hides
# navigator.mediaDevices outside a secure context, so on plain http://<lan-ip>
# the output-device picker cannot exist at all. Caddy's internal CA issues the
# certificate; the first visit warns once, and installing the CA on the laptop
# (docker cp bag-tls:/data/caddy/pki/authorities/local/root.crt .) removes even
# that. Port 8020 keeps serving plain HTTP, so nothing that already works breaks.
#
# WHY the addresses are spelled out instead of a bare ":8444": Caddy issues a
# certificate per site name, and a browser reaching an IP sends no SNI, so a
# hostless block has nothing to present and the handshake dies with an internal
# error. Naming the box's LAN address (and localhost, for the box's own probes)
# puts those names in the certificate.
{
	auto_https disable_redirects
	admin off
}

https://192.168.125.10:8444, https://localhost:8444, https://127.0.0.1:8444 {
	tls internal
	reverse_proxy 127.0.0.1:8020 {
		# The Play and Speaker pages hold a WebSocket open for the whole session.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
